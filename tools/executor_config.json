{
  "schema_version": "representation-lifting-executor-config/v1",
  "primary_model_id": "claude-sonnet-4-6",
  "replication_model_id": "gpt-5.6-sol",
  "pinned_models": {
    "claude-sonnet-4-6": {
      "provider": "Anthropic",
      "pinned_model_id": "claude-sonnet-4-6",
      "endpoint": "https://api.anthropic.com/v1/messages",
      "env_var": "ANTHROPIC_API_KEY",
      "headers": {
        "anthropic-version": "2023-06-01",
        "content-type": "application/json"
      },
      "sampling_parameters": {
        "temperature": 0.0,
        "max_tokens": 8192
      }
    },
    "gpt-5.6-sol": {
      "provider": "OpenAI",
      "pinned_model_id": "gpt-5.6-sol",
      "endpoint": "https://api.openai.com/v1/chat/completions",
      "env_var": "OPENAI_API_KEY",
      "headers": {
        "content-type": "application/json"
      },
      "sampling_parameters": {
        "temperature": 0.0,
        "max_tokens": 8192
      }
    }
  },
  "roles": {
    "S": {
      "description": "Representation Search Executor",
      "max_wallclock_seconds": 3600,
      "max_turns": 15
    },
    "D": {
      "description": "Direct Proof Executor",
      "max_wallclock_seconds": 10800,
      "max_turns": 30
    },
    "L": {
      "description": "Lifted Proof Executor",
      "max_wallclock_seconds": 10800,
      "max_turns": 30
    }
  },
  "transport_policy": {
    "max_attempts_per_turn": 3,
    "retryable_http_codes": [408, 429, 500, 502, 503, 504],
    "backoff_seconds": [5, 15],
    "request_timeout_seconds": 600
  }
}
